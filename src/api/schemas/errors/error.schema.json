{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "title": "Error response",
  "type": "object",
  "required": ["errors"],
  "additionalProperties": false,
  "properties": {
    "errors": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {
        "body": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
