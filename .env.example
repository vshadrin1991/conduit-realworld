# Copy to .env (and optionally .env.<TEST_ENV>) and adjust.
# Precedence: real environment variables > .env.<TEST_ENV> > .env > defaults in src/config/*.config.ts.

# ---------- Environment (src/config/env.config.ts) ----------
# Environment name; also loads .env.<TEST_ENV> on top of this file
TEST_ENV=demo
BASE_URL=https://conduit-realworld-example-app.fly.dev
# Marker included in generated test data names (tests delete only data that contains it)
AUTOMATION_KEY=pwauto

# ---------- Auth (src/config/auth.config.ts) ----------
# Optional existing account (set both). Without it a user is registered once and cached in AUTH_DIR.
# Auth endpoints are rate limited (~5 requests/hour per IP), so reusing an account is recommended.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
AUTH_DIR=.auth
AUTH_LOCK_STALE_MS=60000

# ---------- Framework (src/config/framework.config.ts) ----------
# chromium | firefox | webkit
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
LOCALE=en-US
TIMEZONE=UTC
# Empty = Playwright default (half of CPU cores); CI default is 2
WORKERS=
# Default: 1 on CI, 0 locally
RETRIES=
# api project: every test may run in its own worker
FULLY_PARALLEL=true
# ui project: false = one browser (worker) per spec file, its tests run sequentially; files run in parallel
UI_FULLY_PARALLEL=false
# ui project: true = a new browser is launched for every test; false = new context in the worker's browser
UI_NEW_BROWSER_PER_TEST=true
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000
# off | on | retain-on-failure | on-first-retry | on-all-retries | retain-on-first-failure
TRACE=retain-on-failure
# off | on | retain-on-failure | on-first-retry
VIDEO=retain-on-failure
# off | on | only-on-failure | on-first-failure
SCREENSHOT=only-on-failure
# debug | info | warn | error (report attachments always contain every level)
LOG_LEVEL=info
# Interceptor: browser calls under /api/ and console output of every test, attached to failed tests
# off | failed (4xx/5xx and failed requests) | all
INTERCEPTOR_NETWORK=failed
# off | errors (errors and warnings) | all
INTERCEPTOR_CONSOLE=errors
# Maximum characters kept per request/response body (0 = no bodies); passwords and tokens are masked
INTERCEPTOR_BODY_MAX=2000

# ---------- Reports (src/config/report.config.ts) ----------
REPORTS_DIR=reports
# never | always | on-failure
HTML_REPORT_OPEN=never
ALLURE=true
# Default: true on CI
JUNIT=
# reports/artifacts.json: error, screenshot, video and DOM snapshot (dom.html) of every failed or flaky test
ARTIFACTS=true
